# ============================
# 公益站自动签到 配置模板（复制为 .env）
# ============================
#
# 使用方法：
# 1) 复制本文件为 .env
#    Windows: copy env.template .env
# 2) 用记事本编辑 .env，填入你的账号信息
#
# 注意：
# - .env 属于敏感文件（包含 cookie），不要上传/分享
# - JSON 建议使用单行格式，也兼容多行 Secret

# 必填：账号配置（JSON 数组）
# GitHub 登录账号：使用 AnyRouter 域名下的 session 和匹配的 api_user，不是 GitHub Cookie。
# 可选站点邮箱密码登录：[{"email":"test@example.com","password":"站点独立密码"}]，不可填 GitHub 密码。
# 示例（单行）：
# ANYROUTER_ACCOUNTS=[{"name":"AnyRouter主账号","provider":"anyrouter","cookies":{"session":"你的session"},"api_user":"12345"},{"name":"AgentRouter账号","provider":"agentrouter","cookies":{"session":"你的session"},"api_user":"67890"}]
ANYROUTER_ACCOUNTS=

# 可选：自定义 provider（JSON 对象）
# 示例：
# PROVIDERS={"custom":{"domain":"https://custom.example.com","signin_method":"browser_waf"}}
PROVIDERS=

# 可选：通知渠道（填任意一种即可）
FEISHU_WEBHOOK=
DINGDING_WEBHOOK=
WEIXIN_WEBHOOK=
PUSHPLUS_TOKEN=
SERVERPUSHKEY=
GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
EMAIL_SENDER=
CUSTOM_SMTP_SERVER=
BARK_KEY=
BARK_SERVER=


# 浏览器和代理（可选）
# DEBUG_MODE=false
# CHECKIN_HEADLESS=true
# CHECKIN_BROWSER_PROFILE_DIR=.browser_profiles
# CLOAKBROWSER_BINARY_PATH=/path/to/browser
# CHECKIN_PROXY_URL=http://127.0.0.1:7890
# PROXY_SUBSCRIPTION_URL=https://example.com/sub?token=xxx
